---
import type { Breadcrumb } from '../../layouts/Blog.astro';
import type { GetStaticPaths } from "astro";
import type { BlogPost } from '../../lib/blog/types';
import IndexLayout from '../../layouts/blog/Index.astro';
import { getCollection } from "astro:content";
import { sortPosts } from "../../lib/blog/util";

interface Props {
	posts: BlogPost[],
}

export const getStaticPaths = (async ({}) => {
	const posts = await getCollection('blog');

	return Array
		.from(Map.groupBy(posts, ({data: {prefix}}) => prefix))
		.flatMap(([prefix, posts]) =>
			Array
				.from(Map.groupBy(posts, ({data: {published}}) => published.toISOString().slice(0, 4)))
				.map(([year, posts]) =>
					({params: {year: `${year}`, blogPrefix: prefix}, props: {posts: posts.toSorted(sortPosts)}})))
}) satisfies GetStaticPaths;

const {year, blogPrefix} = Astro.params;
const {posts} = Astro.props;

const name = /[^/]+$/.exec(blogPrefix)?.at(0) || 'blog';
const breadcrumbs: Breadcrumb[] = [
	{title: name, url: `/${blogPrefix}/`},
	{title: year},
];
---

<IndexLayout prefix={blogPrefix} breadcrumbs={breadcrumbs} posts={posts} />
