---
import type { GetStaticPaths } from "astro";
import type { BlogPost } from '../../../lib/blog/types';
import MonthlyArchive from '../../../layouts/blog/Month.astro';
import { getCollection } from "astro:content";

interface Props {
	posts: BlogPost[],
}

export const getStaticPaths = (async ({}) => {
	const posts = await getCollection('blog');

	return Array
		.from(Map.groupBy(posts, ({data: {prefix}}) => prefix))
		.flatMap(([prefix, posts]) =>
			Array
				.from(Map.groupBy(posts, ({data: {published}}) => published.toISOString().slice(0, 4)))
				.flatMap(([year, posts]) =>
					Array
						.from(Map.groupBy(posts, ({data: {published}}) => published.toISOString().slice(5, 7)))
						.map(([month, posts]) =>
							({
								params: {
									blogPrefix: prefix,
									year: `${year}`,
									month: month
								},
								props: {
									posts,
								}
							}))))
	
}) satisfies GetStaticPaths;

const {year, month, blogPrefix} = Astro.params;
const {posts} = Astro.props;
---

<MonthlyArchive prefix={blogPrefix} posts={posts} year={year} month={month} />
