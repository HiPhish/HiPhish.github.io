---
import type { Breadcrumb } from '../../layouts/Blog.astro';
import type { GetStaticPaths } from "astro";
import type { BlogPost } from '../../lib/blog/types';
import type { Page } from 'astro';

import PaginatedIndexLayout from '../../layouts/blog/PaginatedIndex.astro';
import { sortPosts } from '../../lib/blog/util';
import { getCollection } from "astro:content";

export const getStaticPaths = (async ({paginate}) => {
	const posts: BlogPost[] = (await getCollection('blog'))
		.toSorted(sortPosts);
	return Array
		.from(Map.groupBy(posts, ({data: {prefix}}) => prefix))
		.flatMap(([prefix, posts]) => paginate(posts, {pageSize: 10, params: {blogPrefix: prefix}}))
}) satisfies GetStaticPaths;

interface Props {
	page: Page<BlogPost>,
}

const {page} = Astro.props;
const {blogPrefix} = Astro.params;
const breadcrumbs: Breadcrumb[] = [
	{title: /[^/]+$/.exec(blogPrefix)?.at(0) || 'blog'},
];
---

<PaginatedIndexLayout page={page} prefix={blogPrefix} breadcrumbs={breadcrumbs} />
