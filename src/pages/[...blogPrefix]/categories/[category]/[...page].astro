---
import type { GetStaticPaths, Page } from "astro";
import type { BlogPost } from '../../../../lib/blog/types';
import CategoryLayout from '../../../../layouts/blog/Category.astro';
import { getCollection } from "astro:content";

interface Props {
	page: Page<BlogPost>
}

export const getStaticPaths = (async ({paginate}) => {
	const posts = await getCollection('blog');

	return Array
		.from(Map.groupBy(posts, ({data: {prefix}}) => prefix))
		.flatMap(([prefix, posts]) =>
			Array
				.from(Map.groupBy(posts, ({data: {category}}) => category))
				.filter(([category, _]) => Boolean(category))
				.flatMap(([category, posts]) => paginate(posts, {params: {category: category as string, blogPrefix: prefix}})))
}) satisfies GetStaticPaths;

const {page} = Astro.props;
const {category, blogPrefix} = Astro.params;
---

<CategoryLayout category={category as string} page={page} prefix={blogPrefix} />
