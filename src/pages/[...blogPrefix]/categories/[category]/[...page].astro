---
import type { Breadcrumb } from '../../../../layouts/Blog.astro';
import type { GetStaticPaths, Page } from "astro";
import type { BlogPost } from '../../../../lib/blog/types';
import PaginatedIndex from '../../../../layouts/blog/PaginatedIndex.astro';
import { getCollection } from "astro:content";

interface Props {
	page: Page<BlogPost>
}

export const getStaticPaths = (async ({paginate}) => {
	const posts = await getCollection('blog');

	return Array
		.from(Map.groupBy(posts, ({data: {prefix}}) => prefix))
		.flatMap(([prefix, posts]) =>
			Array
				.from(Map.groupBy(posts, ({data: {category}}) => category))
				.filter(([category, _]) => Boolean(category))
				.flatMap(([category, posts]) => paginate(posts, {params: {category: category as string, blogPrefix: prefix}})))
}) satisfies GetStaticPaths;

const {page} = Astro.props;
const {category, blogPrefix} = Astro.params;

const name = /[^/]+$/.exec(blogPrefix)?.at(0) || 'blog';
const breadcrumbs: Breadcrumb[] = [
	{title: name, url: `/${blogPrefix}/`},
	{title: 'categories', url: `/${blogPrefix}/categories/`},
	{title: category},
];
---

<PaginatedIndex page={page} prefix={blogPrefix} breadcrumbs={breadcrumbs} />
