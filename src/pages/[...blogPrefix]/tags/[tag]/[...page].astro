---
import type { Breadcrumb } from '../../../../layouts/Blog.astro';
import type { GetStaticPaths, Page } from "astro";
import type { BlogPost } from '../../../../lib/blog/types';
import PaginatedIndex from '../../../../layouts/blog/PaginatedIndex.astro';
import { getCollection } from "astro:content";

interface Props {
	page: Page<BlogPost>
}

export const getStaticPaths = (async ({paginate}) => {
	const posts = await getCollection('blog');

	return Array
		.from(Map.groupBy(posts, ({data: {prefix}}) => prefix))
		.flatMap(([prefix, posts]) =>
			Array
				.from(Map.groupBy(posts.flatMap((post) => post.data.tags.map((tag): [string, BlogPost] => [tag, post])), ([tag, _]) => tag))
				.map(([tag, tagAndPosts]): [string, BlogPost[]] => [tag, tagAndPosts.map(([_, posts]) => posts)])
				.flatMap(([tag, posts]) => paginate(posts, {params: {tag, blogPrefix: prefix}})))
}) satisfies GetStaticPaths;

const {page} = Astro.props;
const {tag, blogPrefix} = Astro.params;
const name = /[^/]+$/.exec(blogPrefix)?.at(0) || 'blog';
const breadcrumbs: Breadcrumb[] = [
	{title: name, url: `/${blogPrefix}/`},
	{title: 'tags', url: `/${blogPrefix}/tags/`},
	{title: tag},
];
---

<PaginatedIndex page={page} prefix={blogPrefix} breadcrumbs={breadcrumbs} />
