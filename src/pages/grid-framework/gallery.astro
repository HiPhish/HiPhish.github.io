---
import Page from '../../layouts/Page.astro';
import SubNav from '../../components/organism/SubNav.astro';
import { LightGallery } from 'astro-lightgallery';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const gallery = await getCollection('gridFrameworkGallery');

const imageToEntry = ({data: {file, description}}: CollectionEntry<'gridFrameworkGallery'>) =>
	({src: `/grid-framework/gallery/${file}`, alt: description});
---

<style>
	@import 'tailwindcss';
	@import '../../styles/theme.css';

	.gallery {
		@apply grid grid-cols-2 md:grid-cols-4 gap-4;
		> * {
			@apply p-1 rounded-md hover:border;
			@apply bg-white dark:bg-gray-800;
		}
	}
</style>

<Page pageTitle='Gallery | Grid Framework'>
	<SubNav subSite='grid-framework' currentTag='gallery' />
	<h1>Gallery</h1>
	<p>
		Click on one of the thumbnails to see the full image or mouse over for
		the description. The examples shown here are all included with Grid
		Framework. Please keep in mind that the
		<a href="https://starscenesoftware.com/vectrosity.html">Vectrosity</a>
		example requires you to own a Vectrosity license.
	</p>
	<LightGallery
		layout={{
			imgs: gallery.map(imageToEntry),
			classContainer: 'gallery'
		}}
		options={{thumbnail: true}}
	/>
</Page>
