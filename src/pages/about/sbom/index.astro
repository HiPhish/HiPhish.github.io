---
import { spawnSync } from 'node:child_process';
import Page from '../../../layouts/Page.astro';

interface Package {
	name: string,
	versions: string[],
	paths: string[],
	license: string,
	author: string,
	homepage: string,
	description: string,
};

// This should use the `pnpm sbom` command once it gets released
const sbom: Record<string, Package[]> =
	JSON.parse(spawnSync('pnpm', ['licenses', 'list', '--json']).stdout.toString());
---

<style>
	thead > tr > th {
		baseline-shift: top;
		> input {
			display: block;
		}
	}
	td.number {
		text-align: right;
	}
</style>

<Page pageTitle='Software Bill of Materials'>
	<h1>Software Bill of Materials</h1>

	<p>This is the complete list of all dependencies. Generated by pnpm.</p>

	<ul>
		<li>SPDX format: <a href="./spdx.json"><code>spdx.json</code></a></li>
		<li>CycloneDX format: <a href="./cyclonedx.json"><code>cyclonedx.json</code></a></li>
	</ul>

	<h2>Statistics</h2>

	<table>
		<tbody>
			<tr>
				<td>Total number of dependencies</td>
				<td class='number'>
					{Object.entries(sbom).map(([_, ps]) =>ps.length).reduce((n, i) => n + i)}
				</td>
			</tr>
			<tr>
				<td>Total number of licenses</td>
				<td class='number'>
					{(new Set(Object.entries(sbom).map(([license, _]) => license))).size}
				</td>
			</tr>
			{Object.entries(sbom).map(([l, ps]) =>
				<tr>
					<td>{l}</td>
					<td class='number'>{ps.length}</td>
				</tr>)}
		</tbody>
	</table>

	<h2>Full list</h2>

	<table x-data='{name: "", license: ""}'>
		<thead>
			<tr>
				<th>Package <input style="width: auto;" type="text" x-model="name"/></th>
				<th>Version</th>
				<th>License <input style="width: auto;" type="text" x-model="license"/></th>
				<th>Details</th>
			</tr>
		</thead>
		<tbody>
			{Object
				.entries(sbom)
				.flatMap(([l, ps]) => ps.map((p: Package) => [l, p] as [string, Package]))
				.map(([license, {name, versions, author, description, homepage}]) =>
					<tr
						x-data
						x-show="$refs.name.textContent.toLowerCase().includes(name) && $refs.license.textContent.toLowerCase().includes(license)"
					>
						<td><a href={homepage} x-ref="name">{name}</a></td>
						<td>{versions[0]}</td>
						<td x-ref="license">{license}</td>
						<td>
							{author}
							<br />
							{description}
						</td>
					</tr>)}
		</tbody>
	</table>
</Page>
