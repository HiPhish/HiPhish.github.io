---
import { spawnSync } from 'node:child_process';
import Page from '../../../layouts/Page.astro';

interface Package {
	name: string,
	versions: string[],
	paths: string[],
	license: string,
	author: string,
	homepage: string,
	description: string,
};

const sbom: Record<string, Package[]> =
	JSON.parse(spawnSync('pnpm', ['licenses', 'list', '--json']).stdout.toString());
---

<Page pageTitle='Software Bill of Materials'>
	<h1>Software Bill of Materials</h1>

	<p>This is the complete list of all dependencies. Generated by pnpm.</p>

	<table>
		<thead>
			<tr>
				<th>Package</th>
				<th>Version</th>
				<th>License</th>
				<th>Homepage</th>
			</tr>
		</thead>
		<tbody>
			{Object
				.entries(sbom)
				.flatMap(([l, ps]) => ps.map((p: Package) => [l, p] as [string, Package]))
				.map(([license, {name, versions, homepage}]) => <tr>
					<td>{name}</td>
					<td>{versions[0] || 'undefined'}</td>
					<td>{license}</td>
					<td><a href={homepage} target="_blank">External link</a></td>
				</tr>)}
		</tbody>
	</table>
</Page>
