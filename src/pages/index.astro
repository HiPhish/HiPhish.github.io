---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/Base.astro';
import Hero from '../components/organism/Hero.astro';
import Product from '../components/homepage/product.astro';
import BlogPostPreview from '../components/homepage/BlogPostPreview.astro';
import '../styles/pages/homepage.css';

type BlogPostPreview = CollectionEntry<'blog'>;

const products = await getCollection('products');
const blog = await getCollection('blog');

/** Whether the entry is a post on the main blog. */
const isBlogPost = ({data: {prefix}}: BlogPostPreview) =>
	prefix === 'blog';

/** Order blog posts by their publication date. */
const compareDates = ({data: {published: d1}}: BlogPostPreview, {data: {published: d2}}: BlogPostPreview) =>
	d2.valueOf() - d1.valueOf();
---

<BaseLayout>
	<Hero title='Welcome to the workshop'>
		<p>
			This is my personal website where I post hobby projects and blog about
			software and various other topics off the top of my head.
		</p>
		<div>
			<a class="button" href="/blog/">Read the blog</a>
			<a class="button secondary" href="/about/">About me</a>
		</div>
	</Hero>
	<main>
		<section id="blog-posts">
			<h2>Latest posts</h2>
			<div>
				{blog.filter(isBlogPost).sort(compareDates).slice(0, 6).map((post) => <BlogPostPreview post={post} />)}
			</div>
		</section>
		<section id="products">
			<h2>Projects from the workshop</h2>
			<div>
				{products.map(({data}) => <Product {...data} />)}
			</div>
		</section>
	</main>
</BaseLayout>
