---
import type {Page} from "astro";
import type {BlogPost} from '../../../../lib/blog/types';
import TagArchive from '../../../../layouts/blog/Tag.astro';
import {tagArchive} from '../../../../lib/blog/getStaticPath';

interface Props {
	page: Page<BlogPost>
}

export const getStaticPaths = tagArchive('blog');

const {page} = Astro.props;
const {tag} = Astro.params;
---

<TagArchive tag={tag} page={page} />
