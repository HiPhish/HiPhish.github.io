---
import type { Page } from "astro";
import type {BlogPost} from '../../../../lib/blog/types';
import {categoryArchive} from '../../../../lib/blog/getStaticPath';
import CategoryLayout from '../../../../layouts/blog/Category.astro';

interface Props {
	page: Page<BlogPost>
}

export const getStaticPaths = categoryArchive('blog');

const {page} = Astro.props;
const {category} = Astro.params;
---

<CategoryLayout category={category as string} page={page}/>
