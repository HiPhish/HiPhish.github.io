---
import type { GetStaticPaths, Page } from "astro";
import BlogLayout from '../../../../layouts/Blog.astro';
import Paginator from '../../../../components/blog/Pagination.astro';
import Preview from '../../../../components/blog/Preview.astro';
import { CollectionEntry, getCollection } from "astro:content";

type BlogPost = CollectionEntry<'blog'>;

interface Props {
	posts: BlogPost[],
	page: Page<BlogPost>
}

export const getStaticPaths = (async ({paginate}) => {
	const posts: BlogPost[] = await getCollection('blog');
	const result = Array
		.from(Map.groupBy(posts, ({data: {category}}) => category))
		.filter(([c, _]) => Boolean(c))
		.flatMap(([category, ps]) =>
			paginate(
				ps.toSorted(({data: {published: d1}}, {data: {published: d2}}) => d2 - d1),
				{pageSize: 10, props: {posts}, params: {category}}));
	return result
}) satisfies GetStaticPaths;

const {posts, page} = Astro.props;
const {category} = Astro.params;
const breadcrumbs = [
	{title: 'blog', url: '/blog/'},
	{title: 'categories', url: '/blog/categories'},
	{title: category},
];
---

<BlogLayout posts={posts} breadcrumbs={breadcrumbs}>
	<ul>
		{page.data.map((post: BlogPost) => <li><Preview post={post} /></li>)}
	</ul>
	<Paginator page={page} />
</BlogLayout>
