---
import type { GetStaticPaths } from "astro";
import type {BlogPost} from '../../lib/blog/types';
import YearlyArchive from '../../layouts/blog/Year.astro';
import {yearArchive} from '../../lib/blog/getStaticPath.ts';

interface Props {
	posts: BlogPost[],
}

export const getStaticPaths = yearArchive('blog') satisfies GetStaticPaths;
const {year} = Astro.params;
const {posts} = Astro.props;
---

<YearlyArchive year={year} posts={posts} />
