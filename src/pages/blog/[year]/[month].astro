---
import type {BlogPost} from '../../../lib/blog/types';
import MonthlyArchive from '../../../layouts/blog/Month.astro';
import {monthArchive} from '../../../lib/blog/getStaticPath';

interface Props {
	posts: BlogPost[],
}

export const getStaticPaths = monthArchive('blog');

const {year, month} = Astro.params;
const {posts} = Astro.props;
---

<MonthlyArchive posts={posts} year={year} month={month} />
