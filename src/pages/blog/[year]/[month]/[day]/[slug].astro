---
import type {BlogPost} from '../../../../../lib/blog/types';
import {postPage} from '../../../../../lib/blog/getStaticPath';
import PostLayout from '../../../../../layouts/blog/Post.astro';

interface Props {
	post: BlogPost,
};

export const getStaticPaths = postPage('blog');

const {year, month, day, slug} = Astro.params;
const {post} = Astro.props;
---

<PostLayout post={post} year={year} month={month} day={day} slug={slug} />
