---
import type { BlogPost } from '../lib/blog/types';
import { getCollection } from 'astro:content';
import BaseLayout from './Base.astro';

export interface Breadcrumb {
	title: string,
	url?: string,
}

interface Props {
	prefix: string,
	breadcrumbs: Breadcrumb[],
	pageTitle?: string,
}

const {pageTitle, breadcrumbs, prefix} = Astro.props;

const posts: BlogPost[] = (await getCollection('blog')).filter((post) => post.data.prefix === prefix);

const categories = Map.groupBy(posts, ({data: {category}}: BlogPost) => category);

const tags = Map.groupBy(
	posts.flatMap((post: BlogPost) => post.data.tags.map((tag: string): [string, BlogPost] => [tag, post])),
	([tag, _post]) => tag
);

const years = Map.groupBy(
	posts.map((post: BlogPost): [number, BlogPost] => [post.data.published.getFullYear(), post]),
	([year, _post]) => year
);
---

<BaseLayout pageTitle={pageTitle}>
	<div class="blog">
		<nav class="breadcrumbs" aria-label="Breadcrumbs">
			<ol>
				{breadcrumbs?.map(({title, url}: Breadcrumb) =>
					<li class={url ? '' : 'active'}>
						{url ? <a href={url}>{title}</a> : title}
					</li>)
				}
			</ol>
		</nav>
		<slot />
		<!-- Left pillar, article navigation -->
		<nav class="blog-navigation" arial-label="Blog navigation">
			<!-- This navigator contains links to the various archive types. -->	
			<aside>
				<span>Subscribe: </span>
				<a href="#" type="application/rss+xml">RSS</a>
			</aside>
			<nav>
				<h1>
					<a href={`/${prefix}/archive/`}>Archive</a>
				</h1>
				<ul>
					{Array
						.from(years)
						.toSorted(([year1, _post1], [year2, _post2]) => year2 - year1)
						.map(([year, entries]) =>
							<li>
								<a href={`/${prefix}/${year}/`}>{year} ({entries.length})</a>
							</li>)}
				</ul>
			</nav>
			<nav>
				<h1>
					<a href={`/${prefix}/categories/`}>Categories</a>
				</h1>
				<ul>
					{Array
						.from(categories)
						.filter(([category, _]) => Boolean(category))
						.map(([category, entries]) =>
							<li>
								<a href={`/${prefix}/${category}`}>{category} ({entries.length})</a>
							</li>)}
				</ul>
			</nav>
			<nav>
				<h1>
					<a href={`/${prefix}/tags/`}>Tags</a>
				</h1>
				<ul>
					{Array
						.from(tags)
						.map(([tag, entries]) =>
							<li>
								<a href={`/${prefix}/${tag}`}>{tag} ({entries.length})</a>
							</li>)}
				</ul>
			</nav>
		</nav>
	</div>
</BaseLayout>
