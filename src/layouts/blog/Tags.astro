---
import type {BlogPost} from '../../lib/blog/types';
import type {Breadcrumb} from '../../layouts/Blog.astro';
import BlogLayout from '../../layouts/Blog.astro';
import {getCollection} from "astro:content";


const posts: BlogPost[] = await getCollection('blog')

const breadcrumbs: Breadcrumb[] = [
	{title: 'blog', url: '/blog/'},
	{title: 'tags'}
]

const postToTagsAndPost = (post: BlogPost): [string, BlogPost][] =>
	post.data.tags.map((tag: string) => [tag, post]);

const tagsAndPosts: [string, BlogPost][] = posts
	.flatMap(postToTagsAndPost)

const tags = Array
	.from(Map.groupBy(tagsAndPosts, ([tag, _]) => tag))
	.map(([tag, tagsAndPosts]) =>
		[tag, tagsAndPosts.map(([_, post]) => post)] satisfies [string, BlogPost[]])
	.toSorted(([t1, _ps1], [t2, _ps2]) => t1 < t2 ? -1 : 1)
---

<BlogLayout collection='blog' breadcrumbs={breadcrumbs}>
	<ul>
		{tags.map(([tag, posts]) =>
			<li>
				<a href={`/blog/tags/${tag}`}>{tag}</a>
				({posts.length})
				<ul>
					{posts
					.toSorted(({data: {published: d1}}, {data: {published: d2}}) =>
						Number(d2) - Number(d1))
					.map(({id, data: {title}}) =>
						<li>
							<a href={`/blog/${id}`}>{title}</a>
						</li>)}
				</ul>
			</li>)}
	</ul>
</BlogLayout>
