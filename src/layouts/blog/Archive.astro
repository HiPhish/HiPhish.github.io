---
import type { BlogPost } from '../../lib/blog/types';
import BlogLayout, {type Breadcrumb} from '../../layouts/Blog.astro';

interface Props {
	posts: BlogPost[],
	prefix: string,
}

const months = [
	'January',
	'February',
	'March',
	'April',
	'May',
	'June',
	'July',
	'August',
	'September',
	'October',
	'November',
	'December',
];

const {posts, prefix} = Astro.props;

const name = /[^/]+$/.exec(prefix)?.at(0) || 'blog';
const archiveEntries = Map.groupBy(posts, (post: BlogPost) => post.data.published.getFullYear());

const breadcrumbs: Breadcrumb[] = [
	{title: name, url: `/${prefix}/`},
	{title: 'archive'}
];
---

<BlogLayout prefix={prefix} breadcrumbs={breadcrumbs}>
	<ul>
		{Array
			.from(archiveEntries)
			.toSorted()
			.toReversed()
			.map(([year, posts]) =>
				<li>
					{year}
					<ul>
						{Array
							.from(Map.groupBy(posts, ({data: {published}}: BlogPost) => published.getMonth()))
							.toSorted()
							.toReversed()
							.map(([month, posts]) =>
								<li>
									{months[month]}
									<ul>
										{posts
										.toSorted(({data: {published: d1}}, {data: {published: d2}}) => Number(d2) - Number(d1))
										.map((p) =>
											<li>
												<a href={`/${p.id}`}>{p.data.title}</a>
											</li>)}	
									</ul>
								</li>)}
					</ul>
				</li>)}
			
	</ul>
</BlogLayout>
