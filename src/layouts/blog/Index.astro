---
import type { Page } from "astro";
import type { CollectionEntry } from 'astro:content';

import BlogLayout, { type Breadcrumb } from '../../layouts/Blog.astro';
import Preview from '../../components/blog/Preview.astro';
import Pagination from '../../components/blog/Pagination.astro';

type BlogPost = CollectionEntry<'blog'>

interface Props {
	page: Page<BlogPost>,
	prefix: string,
}

const {page, prefix} = Astro.props;;
const name = /[^/]+$/.exec(prefix)?.at(0) || 'blog';

const breadcrumbs: Breadcrumb[] = [
	{title: name},
];
---

<BlogLayout prefix={prefix} breadcrumbs={breadcrumbs}>
	<ul>
		{page.data.map((post) => <li><Preview post={post} /></li>)}
	</ul>
	<Pagination page={page} />
</BlogLayout>
