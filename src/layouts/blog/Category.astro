---
import type { Page } from "astro";
import type {BlogPost} from '../../lib/blog/types.ts';
import BlogLayout, {type Breadcrumb } from '../../layouts/Blog.astro';
import Preview from '../../components/blog/Preview.astro';
import Paginator from '../../components/blog/Pagination.astro';

interface Props {
	page: Page<BlogPost>,
	category: string,
	prefix: string
}

const {category, page, prefix} = Astro.props;

const name = /[^/]+$/.exec(prefix)?.at(0) || 'blog';
const breadcrumbs: Breadcrumb[] = [
	{title: name, url: `/${prefix}/`},
	{title: 'categories', url: `/${prefix}/categories/`},
	{title: category},
];
---

<BlogLayout prefix={prefix} breadcrumbs={breadcrumbs}>
	<ul>
		{page.data.map((post: BlogPost) => <li><Preview post={post} /></li>)}
	</ul>
	<Paginator page={page} />
</BlogLayout>
