---
import type {BlogPost} from '../../lib/blog/types.ts';
import BlogLayout, { type Breadcrumb } from '../../layouts/Blog.astro';

import Preview from '../../components/blog/Preview.astro';

interface Props {
	posts: BlogPost[],
	year: string,
	month: string
	prefix: string,
}

const {posts, year, month, prefix} = Astro.props;

const name = /[^/]+$/.exec(prefix)?.at(0) || 'blog';
const breadcrumbs: Breadcrumb[] = [
	{title: name, url: `/${prefix}/`},
	{title: year, url: `/blog/${year}`},
	{title: month},
];
---

<!-- Monthly archive -->
<BlogLayout prefix={prefix} breadcrumbs={breadcrumbs}>
	<ul>
		{posts.map((post) => <li><Preview post={post} /></li>)}
	</ul>
</BlogLayout>
