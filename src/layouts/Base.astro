---
/** The outer-most layout used for all pages */

import '../styles/global.css';
import NavBar from '../components/organism/GlobalNav.astro';
import NavBarEntry from '../components/organism/GlobalNav/Entry.astro';
import NavBarGroup from '../components/organism/GlobalNav/Group.astro';
import GlobalFooter, {type Social} from '../components/organism/Footer.astro';

interface Props {
	pageTitle?: string,
	lang?: string,
	extraCSS?: string[],
	extraJS?: string[],
}

const {pageTitle, lang, extraCSS, extraJS} = Astro.props;

const socials: Social[] = [
	{
		label: 'GitHub',
		url: 'https://github.com/HiPhish',
	}, {
		label: 'GitLab',
		url: 'https://gitlab.com/HiPhish',
	},
];
---

<!DOCTYPE html>
<html lang={lang || 'en'}>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{pageTitle || 'HiPhish\'s Workshop'}</title>
		<!-- Add global style sheets here -->
		<!-- Extra per-page CSS -->
		{extraCSS?.map(css => <link rel="stylesheet" href={css} type="text/css" media="all"/>)}
		<!-- Extra per-page JavaScript -->
		{extraJS?.map(js => <script src={js} is:inline charset="utf-8"></script>)}
	</head>
	<body>
		<!-- Main navigation bar -->
		<NavBar brand='HiPhish' home='/' navId='global-navigation-bar'>
			<NavBarGroup label='Grid Framework'>
				<NavBarEntry label='Overview' url='/grid-framework/' />
				<NavBarEntry label='Features' url='/grid-framework/features/' />
				<NavBarEntry label='Examples' url='/grid-framework/examples/' />
				<NavBarEntry label='Gallery' url='/grid-framework/gallery/' />
				<NavBarEntry label='Showcase' url='/grid-framework/showcase/' />
				<NavBarEntry label='FAQ' url='/grid-framework/faq/' />
				<NavBarEntry label='News' url='/grid-framework/news/' />
				<NavBarEntry
					label='Support'
					extern={true}
					url='http://forum.unity3d.com/threads/grid-framework-scripting-and-editor-plugins.144886/'
				/>
				<hr/>
				<NavBarEntry
					label=''
					extern={true}
					url='https://www.assetstore.unity3d.com/#/content/62498'
				>
					Buy Now <span class="badge">35$</span>
				</NavBarEntry>
			</NavBarGroup>
			<NavBarGroup label='Open Source'>
				<NavBarEntry extern={true} label='NTFS-Clone' url='https://gitlab.com/HiPhish/ntfs-clone' />
				<NavBarEntry extern={true} label='IPS-Tools' url='https://gitlab.com/HiPhish/IPS-Tools' />
				<NavBarEntry extern={true} label='roll' url='https://gitlab.com/HiPhish/roll' />
				<NavBarEntry extern={true} label="Newton\'s Method in C" url='https://github.com/HiPhish/Newton-method' />
				<NavBarEntry extern={true} label='Xeen Tools' url='https://github.com/HiPhish/XeenTools' />
				<NavBarEntry extern={true} label='Wolf3D Extract' url='https://github.com/HiPhish/Wolf3DExtract' />
				<NavBarEntry extern={true} label='Game Source Documentation' url='https://github.com/HiPhish/Game-Source-Documentation' />
			</NavBarGroup>
			<NavBarGroup label='Vim/Nvim plugins'>
				<NavBarEntry extern={true} label='Info.vim' url='https://gitlab.com/HiPhish/info.vim' />
				<NavBarEntry extern={true} label='REPL.nvim' url='https://gitlab.com/HiPhish/repl.nvim' />
				<NavBarEntry extern={true} label='Quicklisp.nvim' url='https://gitlab.com/HiPhish/quicklisp.nvim' />
				<NavBarEntry extern={true} label='jinja.vim' url='https://gitlab.com/HiPhish/jinja.vim' />
				<NavBarEntry extern={true} label='Guix channel' url='https://gitlab.com/HiPhish/neovim-guix-channel/' />
			</NavBarGroup>
			<NavBarEntry label='Blog' url='/blog/' />
			<NavBarEntry label='About' url='/about/' />
		</NavBar>
		<slot />
		<GlobalFooter socials={socials}>
			© 2015-2026, licensed under
			<a href="http://creativecommons.org/licenses/by-sa/4.0/">CC BA-SA 4.0</a>
		</GlobalFooter>
	</body>
</html>
