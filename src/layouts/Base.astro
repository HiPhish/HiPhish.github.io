---
import '../styles/global.css';
import GlobalNavBar from '../components/GlobalNavBar.tsx';
import GlobalFooter from '../components/GlobalFooter.astro';

interface Props {
	pageTitle?: string,
	lang?: string,
	extraCSS?: string[],
	extraJS?: string[],
}

const {pageTitle, lang, extraCSS, extraJS} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang || 'en'}>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{pageTitle || 'HiPhish\'s Workshop'}</title>
		<!-- Add global style sheets here -->
		<!-- Extra per-page CSS -->
		{extraCSS?.map(css => <link rel="stylesheet" href={css} type="text/css" media="all"/>)}
		<!-- Extra per-page JavaScript -->
		{extraJS?.map(js => <script src={js} is:inline charset="utf-8"></script>)}
	</head>
	<body>
		<header>
			<!-- Main navigation bar -->
			<GlobalNavBar />
		</header>
		<div>
			<slot />
		</div>
		<GlobalFooter/>
	</body>
</html>
