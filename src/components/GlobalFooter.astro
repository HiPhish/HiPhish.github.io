---
import {Image} from 'astro:assets';

const socials = [
	{
		title: 'GitHub',
		url: 'https://github.com/HiPhish',
		image: import('../assets/img/footer/github.png'),
	}, {
		title: 'GitLab',
		url: 'https://gitlab.com/HiPhish',
		image: import('../assets/img/footer/gitlab.png'),
	},
];

const logo = {
	url: '/',
	img: import('../assets/img/footer/logo.png'),
	alt: 'HiPhish\'s Workshop',
}

const copyright = {
	title: 'Creative Commons Attribution-ShareAlike 4.0 International License',
	note: '© 2015-2026, licensed under CC BA-SA 4.0',
	img: import('../assets/img/footer/cc.svg'),
	url: 'http://creativecommons.org/licenses/by-sa/4.0/',
};
---

<footer>
	<!-- This is a wrapper to limit the width -->
	<div>
		<div class="footer-self">
			{!logo ? '' : <a href={logo.url}><Image src={logo.img} alt={logo.alt} height="55" /></a>}
			{!copyright ? '' : <p>
				{copyright.img ? <a href={copyright.url}><Image src={copyright.img} alt={copyright.title}/></a> : ''}
				{copyright.note}
			</p>}
		</div>
		<div class="footer-social">
			{socials.map(({title, url, image}) =>
				<a href={url} title={title} target="blank">
					<Image src={image} alt={title} height="55" />
				</a>)
			}
		</div>
	</div>
</footer>
