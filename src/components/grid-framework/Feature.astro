---
interface Props {
	title: string,
};

const {title} = Astro.props;
---

<style>
	@import 'tailwindcss';

	/* For Alpine to make x-cloak work */
	[x-cloak] {
		display: none !important;
	}

	div.feature {
		@apply bg-white dark:bg-gray-800  dark:border-gray-700;
		@apply rounded-lg p-4;
	}
</style>

<div class="feature" x-data='{collapse: true}'>
	<h2>{title}</h2>
	<slot name='teaser' />
	<div x-show="!collapse" x-collapse x-cloak>
		<slot />
	</div>
	{/* Trick to show the otherwise hidden text */}
	<noscript>
		<slot />
	</noscript>
	<button type="button" x-text="collapse ? 'Show more ↓' : 'Hide ↑'" x-on:click="collapse = !collapse">
		Show more ↓
	</button>
</div>
