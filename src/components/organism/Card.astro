---
interface Props {
	title: string,
	tags: string[],
	label?: string,
	url?: string,
	img?: string,
	alt?: string,
}

const {title, tags = [], label, url, img, alt} = Astro.props;
---

<div class:list={['card']}>
	<h3>{title}</h3>
	{img && <img src={img} alt={alt || ''} />}
	<slot />
	<div>
		<span class="">{tags.join(', ')}</span>
		<a href={url}>{label}</a>
	</div>
</div>
