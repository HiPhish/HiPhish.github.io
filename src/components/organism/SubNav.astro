---
import { getCollection, type InferEntrySchema } from 'astro:content';
import { undefined } from 'astro:schema';

/** Properties of the sub-site navigation bar */
interface Props {
	/** For which sub-site to display the navigation */
	subSite: 'grid-framework',
	/** Tag of the current item (see the item type for tags) */
	currentTag?: string,
};

const {subSite, currentTag} = Astro.props;

const collection = (await getCollection('subSites'))
	.find(({id}) => id === subSite);

const {title, url, items} = collection?.data || {
	title: undefined,
	url: '#',
	items: [],
};

const ariaCurrent = (tag: string) =>
	tag === currentTag ? 'page' : false;

---

<nav class="local-nav">
	<ul>
		<li aria-current={!currentTag ? 'page' : 'false'}>
			<a href={url}>{title}</a>
		</li>
		{items.map(({title, url, tag}) => <li aria-current={ariaCurrent(tag)}><a href={url}>{title}</a></li>)}
	</ul>
</nav>
