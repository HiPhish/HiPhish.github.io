---
// How it works: The menu has two modes of display: hamburger menu or
// horizontal menu.  Which mode is active depends on the width of the screen,
// but the markup is all the same.
//
// There are only two binary stateful elements in HTML: the input and the
// details.  We use a checkbox to toggle the hamburger and details for dropdown
// menu entries.  The checkbox itself is hidden, we instead expose its label.
// Interacting with the label is the same as interacting with the checkbox.
import Entry from './GlobalNav/Entry.astro';
import Group from './GlobalNav/Group.astro';
interface Props {
	brand: string,
	home: string,
}

const {brand, home} = Astro.props;
---

<nav id='global-nav'>
	<!-- Hamburger toggle, this is what the user interacts with -->
    <label tabindex="0" role='button'>
    	<!-- Icon -->
		<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
			<path
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="2"
				d="M1 1h15M1 7h15M1 13h15"
			/>
		</svg>
		<!-- Will be hidden, only serves to keep state -->
    	<input type="checkbox" aria-label="Toggle navigation menu" />
    </label>

    <ul>
		<Entry label={brand} url={home} />
    	<slot>
    		<!-- Default content for testing in Storybook -->
			<Entry label='News' url='#' />
			<Group label='Services'>
				<Entry label='Web design' url='#' />
				<Entry label='Web APIs' url='#' />
				<Entry label='SEO' url='#' />
			</Group>
			<Group label='Products'>
				<Entry label='Devices' url='#' />
				<Entry label='Books' url='#' />
			</Group>
			<Entry label='Pricing' url='#' />
			<Entry label='Contact' url='#' />
		</slot>
    </ul>
</nav>

<!-- Toggle dropdowns on hover -->
<script>
	// NOTE: The hover shall not work if the hamburger is visible
	const hamburger = document.querySelector('nav#global-nav label');
	if (!hamburger) {
		throw Error('Hamburger menu element not found in global navigation')
	}
	const isWide = () =>
		window.getComputedStyle(hamburger).display === 'none';

	document
		.querySelectorAll('nav#global-nav details')
		.forEach(dropdown => {
			dropdown.querySelector('summary')?.addEventListener('click', (evt) => {
				if (isWide())
					evt.preventDefault();
			});
			dropdown.addEventListener('mouseover', () => {
				if (isWide())
					dropdown.setAttribute('open', 'open')
			});
			dropdown.addEventListener('mouseout', () => {
				if (isWide())
					dropdown.removeAttribute('open')
			});
		});
</script>
