---
import Entry from './GlobalNav/Entry.astro';
import Group from './GlobalNav/Group.astro';
interface Props {
	brand: string,
	home: string,
}

const {brand, home} = Astro.props;
---

<nav id='global-nav'>
    <!-- Hamburger toggle -->
    <label for="menu-toggle" tabindex="0">
		<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
			<path
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="2"
				d="M1 1h15M1 7h15M1 13h15"
			/>
		</svg>
    </label>
    <input type="checkbox" id="menu-toggle" aria-label="Toggle navigation menu" />

    <ul>
		<Entry label={brand} url={home} />
    	<slot>
    		<!-- Default content for testing in Storybook -->
			<Entry label='News' url='#' />
			<Group label='Services'>
				<Entry label='Web design' url='#' />
				<Entry label='Web APIs' url='#' />
				<Entry label='SEO' url='#' />
			</Group>
			<Group label='Products'>
				<Entry label='Devices' url='#' />
				<Entry label='Books' url='#' />
			</Group>
			<Entry label='Pricing' url='#' />
			<Entry label='Contact' url='#' />
		</slot>
    </ul>
</nav>

<script>
	// NOTE: The hover shall not work if the hamburger is visible
	const hamburger = document.querySelector('nav#global-nav label') as Element;

	document
		.querySelectorAll('nav#global-nav details')
		.forEach(dropdown => {
			dropdown.addEventListener('mouseover', () => {
				if (window.getComputedStyle(hamburger).display === 'none') {
					dropdown.setAttribute('open', 'open')
				}
			});
			dropdown.addEventListener('mouseout', () => {
				if (window.getComputedStyle(hamburger).display === 'none') {
					dropdown.removeAttribute('open')
				}
			});
		});
</script>
