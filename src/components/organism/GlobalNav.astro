---
interface Entry {
	label: string,
	url: string,
	entries?: Entry[],
};

interface Props {
	home: Entry,
	entries: Entry[],
};

const {home, entries = []} = Astro.props;
---

<nav>
	<div>
		<div><a href={home.url}>{home.label}</a></div>
		<ul>
			{entries.map(({label, url, entries = []}) => {
					if (entries.length === 0) {
						return <li><a href={url}>{label}</a></li>
					}
					return <li class="relative group">
						<button>{label}</button>
						<ul>
							{entries.map(({label, url}) => <li><a href={url}>{label}</a></li>)}
						</ul>
					</li>
				})
			}
		</ul>
	</div>
</nav>
