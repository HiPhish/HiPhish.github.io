---
interface Props {
	label: string,
	url: string,
	current?: astroHTML.JSX.AriaAttributes['aria-current'],
	extern?: boolean,
};

const {label, url, current = false, extern = false} = Astro.props;
---

<li>
	<a href={url} aria-current={current} target={extern ? '_blank' : '_self'}>
		<slot>
			{label}
		</slot>
	</a>
</li>
